#!/usr/bin/env python3

"""Validate every declarative aper rule without depending on catalogue artwork."""

from __future__ import annotations

import argparse
import hashlib
import pathlib
import subprocess
import sys


REPOSITORY = pathlib.Path(__file__).resolve().parents[1]
DEFAULT_APER = REPOSITORY / "aper"
DEFAULT_RULES = REPOSITORY / "rules"


def run(
    arguments: list[str], *, input_data: bytes | None = None
) -> subprocess.CompletedProcess[bytes]:
    completed = subprocess.run(
        arguments,
        cwd=REPOSITORY,
        check=False,
        input=input_data,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if completed.returncode != 0:
        diagnostic = completed.stderr.decode("utf-8", errors="replace").strip()
        raise RuntimeError(f"{' '.join(arguments)} failed: {diagnostic}")
    return completed


def definition_id(definition: bytes, source: pathlib.Path) -> str:
    identifiers = [
        line[3:].strip()
        for line in definition.decode("utf-8").splitlines()
        if line.startswith("id ")
    ]
    if len(identifiers) != 1 or not identifiers[0]:
        raise ValueError(f"{source} has no unique system id")
    return identifiers[0]


def complete_pdf(document: bytes) -> bool:
    return document.startswith(b"%PDF-") and document.rstrip().endswith(b"%%EOF")


def validate(aper: pathlib.Path, source: pathlib.Path) -> tuple[str, str]:
    canonical = run(
        [str(aper), "--file", str(source), "--definition"]
    ).stdout
    identifier = definition_id(canonical, source)
    repeated = run(
        [str(aper), "--file", "-", "--definition"], input_data=canonical
    ).stdout
    if repeated != canonical:
        raise ValueError(f"{source} is not stable under canonical round trip")

    for arguments in (
        [str(aper), "--file", str(source)],
        [str(aper), "--file", str(source), "--rule"],
    ):
        document = run(arguments).stdout
        if not complete_pdf(document):
            raise ValueError(f"{source} produced an incomplete PDF")
    return identifier, hashlib.sha256(canonical).hexdigest()


def parse_arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="validate and canonicalise aper's declarative rule library"
    )
    parser.add_argument("--aper", type=pathlib.Path, default=DEFAULT_APER)
    parser.add_argument("--rules", type=pathlib.Path, default=DEFAULT_RULES)
    return parser.parse_args()


def main() -> int:
    arguments = parse_arguments()
    aper = arguments.aper.resolve()
    rules = arguments.rules.resolve()
    if not aper.is_file():
        raise FileNotFoundError(f"aper executable does not exist: {aper}")
    definitions = sorted(rules.rglob("*.aper"))
    if not definitions:
        raise ValueError(f"no .aper definitions found under {rules}")

    print("id\tdefinition\tcanonical_sha256")
    identifiers: set[str] = set()
    for source in definitions:
        identifier, digest = validate(aper, source)
        if identifier in identifiers:
            raise ValueError(f"duplicate rule-library id: {identifier}")
        identifiers.add(identifier)
        try:
            displayed = source.relative_to(REPOSITORY)
        except ValueError:
            displayed = source
        print(f"{identifier}\t{displayed}\t{digest}")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, RuntimeError, ValueError) as error:
        print(f"check-rule-library: {error}", file=sys.stderr)
        raise SystemExit(1)
