"""Build aper's complete, offline LaTeX catalogue."""

from __future__ import annotations

import argparse
import csv
import hashlib
import os
import pathlib
import re
import shutil
import subprocess
import sys
import tempfile
from dataclasses import dataclass
from typing import Iterable, Optional


REPOSITORY = pathlib.Path(__file__).resolve().parents[1]
DEFAULT_BANK = REPOSITORY / "data" / "encyclopedia.tsv"
DEFAULT_SYSTEMS = REPOSITORY / "doc" / "catalogue" / "systems.tsv"
DEFAULT_TEMPLATE = REPOSITORY / "doc" / "catalogue" / "aper-catalogue.tex"
DEFAULT_OUTPUT = REPOSITORY / ".build" / "catalogue"
DEFAULT_REFERENCE_MANIFEST = DEFAULT_OUTPUT / "reference-assets.tsv"
REFERENCE_FIELDS = [
    "slug",
    "page_url",
    "patch_url",
    "patch_path",
    "patch_sha256",
    "patch_media",
    "rule_url",
    "rule_path",
    "rule_sha256",
    "rule_media",
    "change",
]
SYSTEM_FIELDS = ["aper_system", "title", "record", "seed", "depth", "colour"]
BANK_FIELDS = ["slug", "title", "url", "tags", "aper_system"]
SEARCH_FIELDS = ["index", "system", "exact_bank_match"]
SAFE_SLUG = re.compile(r"[A-Za-z0-9][A-Za-z0-9_-]*\Z")


@dataclass(frozen=True)
class BankRecord:
    slug: str
    title: str
    url: str
    tags: tuple[str, ...]
    aper_system: str


@dataclass(frozen=True)
class Presentation:
    aper_system: str
    title: str
    record: str
    seed: str
    depth: int
    colour: str


@dataclass(frozen=True)
class ReferenceRecord:
    slug: str
    page_url: str
    patch_url: str
    patch_path: str
    patch_sha256: str
    patch_media: str
    rule_url: str
    rule_path: str
    rule_sha256: str
    rule_media: str
    change: str


@dataclass(frozen=True)
class Candidate:
    index: int
    system: str
    exact_bank_match: tuple[str, ...]


@dataclass(frozen=True)
class Artwork:
    path: Optional[pathlib.Path]
    caption: str
    change: str
    missing: str = ""
    source_url: str = ""


@dataclass(frozen=True)
class SearchListing:
    statistics: dict[str, str]
    candidates: tuple[Candidate, ...]


def normalise(text: str) -> str:
    return " ".join(text.split())


def tex(text: str) -> str:
    replacements = {
        "\\": r"\textbackslash{}",
        "{": r"\{",
        "}": r"\}",
        "$": r"\$",
        "&": r"\&",
        "#": r"\#",
        "%": r"\%",
        "_": r"\_",
        "~": r"\textasciitilde{}",
        "^": r"\textasciicircum{}",
    }
    return "".join(replacements.get(character, character) for character in text)


def atomic_write(path: pathlib.Path, content: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary_path: Optional[pathlib.Path] = None
    try:
        with tempfile.NamedTemporaryFile(
            "w", encoding="utf-8", dir=path.parent, delete=False
        ) as temporary:
            temporary.write(content)
            temporary_path = pathlib.Path(temporary.name)
        os.chmod(temporary_path, 0o644)
        os.replace(temporary_path, path)
        temporary_path = None
    finally:
        if temporary_path is not None:
            temporary_path.unlink(missing_ok=True)


def sha256(path: pathlib.Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as source:
        for block in iter(lambda: source.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def environment() -> dict[str, str]:
    result = dict(os.environ)
    result.update(
        {
            "LC_ALL": "C",
            "LANG": "C",
            "TZ": "UTC",
            "SOURCE_DATE_EPOCH": "0",
            "FORCE_SOURCE_DATE": "1",
        }
    )
    return result


def command_text(arguments: Iterable[object]) -> str:
    return " ".join(str(argument) for argument in arguments)


def run_text(arguments: list[str], cwd: pathlib.Path) -> str:
    completed = subprocess.run(
        arguments,
        cwd=cwd,
        env=environment(),
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if completed.returncode != 0:
        diagnostics = "\n".join(
            part[-4000:] for part in (completed.stdout, completed.stderr) if part
        )
        detail = normalise(diagnostics) or "no diagnostic"
        raise RuntimeError(f"{command_text(arguments)} failed: {detail}")
    return completed.stdout


def render_pdf(arguments: list[str], target: pathlib.Path, cwd: pathlib.Path) -> None:
    target.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(dir=target.parent, suffix=".pdf")
    temporary = pathlib.Path(temporary_name)
    try:
        with os.fdopen(descriptor, "wb") as output:
            completed = subprocess.run(
                arguments,
                cwd=cwd,
                env=environment(),
                check=False,
                stdout=output,
                stderr=subprocess.PIPE,
            )
        if completed.returncode != 0:
            detail = normalise(completed.stderr.decode("utf-8", errors="replace"))
            raise RuntimeError(f"{command_text(arguments)} failed: {detail}")
        document = temporary.read_bytes()
        if not document.startswith(b"%PDF-") or not document.rstrip().endswith(b"%%EOF"):
            raise ValueError(f"{command_text(arguments)} did not produce a complete PDF")
        os.chmod(temporary, 0o644)
        os.replace(temporary, target)
    finally:
        temporary.unlink(missing_ok=True)


def read_commented_tsv(
    path: pathlib.Path, expected_fields: list[str]
) -> tuple[dict[str, str], list[dict[str, str]]]:
    metadata: dict[str, str] = {}
    table_lines: list[str] = []
    for line in path.read_text(encoding="utf-8").splitlines():
        if line.startswith("#"):
            item = line[1:].strip()
            if ":" in item:
                key, value = item.split(":", 1)
                metadata[key.strip()] = value.strip()
            continue
        if line:
            table_lines.append(line)
    if not table_lines:
        raise ValueError(f"{path} contains no table")
    reader = csv.DictReader(table_lines, delimiter="\t")
    if reader.fieldnames != expected_fields:
        raise ValueError(
            f"{path} has fields {reader.fieldnames}; expected {expected_fields}"
        )
    rows = list(reader)
    if any(None in row for row in rows):
        raise ValueError(f"{path} contains a malformed row")
    return metadata, rows


def read_bank(path: pathlib.Path) -> tuple[dict[str, str], tuple[BankRecord, ...]]:
    metadata, rows = read_commented_tsv(path, BANK_FIELDS)
    records: list[BankRecord] = []
    for row in rows:
        slug = row["slug"]
        if not SAFE_SLUG.fullmatch(slug):
            raise ValueError(f"unsafe Encyclopedia slug: {slug}")
        raw_tags = row["tags"]
        if raw_tags in {"", "-"}:
            tags: tuple[str, ...] = ()
        else:
            tags = tuple(raw_tags.split("|"))
            if any(not tag for tag in tags):
                raise ValueError(f"ambiguous tag separator in {slug}")
        source = metadata.get("source", "").rstrip("/") + "/"
        expected_url = source + slug + "/"
        if source != "/" and row["url"] != expected_url:
            raise ValueError(f"non-canonical Encyclopedia URL for {slug}")
        records.append(
            BankRecord(
                slug,
                row["title"],
                row["url"],
                tags,
                "" if row["aper_system"] == "-" else row["aper_system"],
            )
        )
    slugs = [record.slug for record in records]
    if slugs != sorted(slugs):
        raise ValueError(f"{path} is not sorted by slug")
    if len(slugs) != len(set(slugs)):
        raise ValueError(f"{path} contains duplicate slugs")
    declared = metadata.get("records")
    if declared is not None and int(declared) != len(records):
        raise ValueError(
            f"{path} declares {declared} records but contains {len(records)}"
        )
    if not records:
        raise ValueError(f"{path} contains no records")
    return metadata, tuple(records)


def read_systems(path: pathlib.Path) -> tuple[Presentation, ...]:
    _, rows = read_commented_tsv(path, SYSTEM_FIELDS)
    systems: list[Presentation] = []
    for row in rows:
        try:
            depth = int(row["depth"])
        except ValueError as error:
            raise ValueError(f"invalid depth for {row['aper_system']}") from error
        if depth < 1:
            raise ValueError(f"invalid depth for {row['aper_system']}")
        systems.append(
            Presentation(
                row["aper_system"],
                row["title"],
                row["record"],
                row["seed"],
                depth,
                row["colour"],
            )
        )
    identifiers = [system.aper_system for system in systems]
    records = [system.record for system in systems]
    if len(identifiers) != len(set(identifiers)) or len(records) != len(set(records)):
        raise ValueError(f"{path} contains duplicate systems or records")
    if not systems:
        raise ValueError(f"{path} contains no executable known systems")
    return tuple(systems)


def read_reference_manifest(path: pathlib.Path) -> dict[str, ReferenceRecord]:
    header = next(
        (
            line.split("\t")
            for line in path.read_text(encoding="utf-8").splitlines()
            if line and not line.startswith("#")
        ),
        [],
    )
    accepted_fields = [REFERENCE_FIELDS, REFERENCE_FIELDS[:-1] + ["changes"]]
    if header not in accepted_fields:
        raise ValueError(
            f"{path} has fields {header}; expected change or changes as its final field"
        )
    _, rows = read_commented_tsv(path, header)
    result: dict[str, ReferenceRecord] = {}
    for row in rows:
        record = ReferenceRecord(
            slug=row["slug"],
            page_url=row["page_url"],
            patch_url=row["patch_url"],
            patch_path=row["patch_path"],
            patch_sha256=row["patch_sha256"],
            patch_media=row["patch_media"],
            rule_url=row["rule_url"],
            rule_path=row["rule_path"],
            rule_sha256=row["rule_sha256"],
            rule_media=row["rule_media"],
            change=row.get("change", row.get("changes", "")),
        )
        if record.slug in result:
            raise ValueError(f"duplicate reference-art record: {record.slug}")
        result[record.slug] = record
    return result


def read_known_listing(aper_search: pathlib.Path) -> dict[str, tuple[str, str]]:
    listing = run_text([str(aper_search), "--list-known"], REPOSITORY)
    result: dict[str, tuple[str, str]] = {}
    for line in listing.splitlines():
        if not line or line.startswith("#"):
            continue
        fields = line.split("\t")
        if len(fields) != 3:
            raise ValueError("aper-search --list-known returned malformed output")
        identifier, record, url = fields
        if identifier in result:
            raise ValueError(f"duplicate known system from aper-search: {identifier}")
        result[identifier] = (record, url)
    if not result:
        raise ValueError("aper-search --list-known returned no systems")
    return result


def validate_system_mappings(
    records: tuple[BankRecord, ...],
    systems: tuple[Presentation, ...],
    known: dict[str, tuple[str, str]],
) -> None:
    bank_mappings = {
        record.aper_system: (record.slug, record.url)
        for record in records
        if record.aper_system
    }
    manifest_mappings = {system.aper_system: system.record for system in systems}
    if set(manifest_mappings) != set(known) or set(bank_mappings) != set(known):
        raise ValueError(
            "systems.tsv, encyclopedia.tsv, and aper-search disagree on known IDs"
        )
    for identifier, (record, url) in known.items():
        if manifest_mappings[identifier] != record:
            raise ValueError(f"systems.tsv maps {identifier} to the wrong record")
        if bank_mappings[identifier] != (record, url):
            raise ValueError(f"encyclopedia.tsv maps {identifier} inconsistently")


def read_candidates(aper_search: pathlib.Path) -> SearchListing:
    output = run_text(
        [str(aper_search), "--space", "binary-square", "--list-candidates"],
        REPOSITORY,
    )
    statistics: dict[str, str] = {}
    table: list[str] = []
    for line in output.splitlines():
        if line.startswith("#"):
            fields = line[1:].strip().split("\t")
            if len(fields) != 2:
                raise ValueError("malformed binary-square statistic")
            statistics[fields[0]] = fields[1]
        elif line:
            table.append(line)
    required_statistics = {
        "search-space",
        "generated",
        "structurally-valid",
        "algebraically-valid",
        "geometrically-valid",
        "canonicalised",
        "unique",
        "encoded-bank",
    }
    if set(statistics) != required_statistics:
        raise ValueError("binary-square listing returned unexpected statistics")
    if statistics["search-space"] != "binary-square":
        raise ValueError("aper-search returned the wrong search space")
    reader = csv.DictReader(table, delimiter="\t")
    if reader.fieldnames != SEARCH_FIELDS:
        raise ValueError("binary-square listing returned an unexpected header")
    candidates: list[Candidate] = []
    for row in reader:
        if None in row:
            raise ValueError("binary-square listing contains a malformed row")
        try:
            index = int(row["index"])
        except ValueError as error:
            raise ValueError("binary-square candidate index is not an integer") from error
        matches = (
            ()
            if row["exact_bank_match"] == "-"
            else tuple(row["exact_bank_match"].split(","))
        )
        candidates.append(Candidate(index, row["system"], matches))
    if [candidate.index for candidate in candidates] != list(range(len(candidates))):
        raise ValueError("binary-square candidate indices are not contiguous")
    if int(statistics["unique"]) != len(candidates):
        raise ValueError("binary-square unique count disagrees with its rows")
    if not candidates:
        raise ValueError("binary-square search returned no candidates")
    return SearchListing(statistics, tuple(candidates))


def resolve_manifest_path(text: str, manifest: pathlib.Path) -> pathlib.Path:
    value = pathlib.Path(text)
    if value.is_absolute():
        return value
    candidates = (REPOSITORY / value, manifest.parent / value)
    for candidate in candidates:
        if candidate.exists():
            return candidate
    return candidates[0]


def media_kind(media: str, path: pathlib.Path) -> str:
    value = media.lower().split(";", 1)[0].strip()
    suffix = path.suffix.lower()
    if "pdf" in value or suffix == ".pdf":
        return "pdf"
    if "png" in value or suffix == ".png":
        return "png"
    if "jpeg" in value or "jpg" in value or suffix in {".jpg", ".jpeg"}:
        return "jpg"
    if "svg" in value or suffix == ".svg":
        return "svg"
    if "gif" in value or suffix == ".gif":
        return "gif"
    if "tiff" in value or suffix in {".tif", ".tiff"}:
        return "tiff"
    if "bmp" in value or suffix == ".bmp":
        return "bmp"
    if "webp" in value or suffix == ".webp":
        return "webp"
    if "postscript" in value or suffix in {".eps", ".ps"}:
        return "eps"
    raise ValueError(f"unsupported reference media {media!r} at {path}")


def convert_command(kind: str, source: pathlib.Path, target: pathlib.Path) -> list[str]:
    if kind == "svg":
        converter = shutil.which("rsvg-convert")
        if converter:
            return [converter, "-f", "pdf", "-o", str(target), str(source)]
        converter = shutil.which("inkscape")
        if converter:
            return [converter, str(source), "--export-type=pdf", f"--export-filename={target}"]
        raise RuntimeError("SVG reference art requires rsvg-convert or inkscape")
    if kind == "eps":
        converter = shutil.which("epstopdf")
        if converter:
            return [converter, str(source), f"--outfile={target}"]
        raise RuntimeError("EPS reference art requires epstopdf")
    converter = shutil.which("magick") or shutil.which("convert")
    if converter:
        return [converter, str(source), str(target)]
    converter = shutil.which("sips")
    if converter:
        return [converter, "-s", "format", "png", str(source), "--out", str(target)]
    raise RuntimeError(f"{kind.upper()} reference art requires magick, convert, or sips")


def copy_or_convert_reference(
    source: pathlib.Path,
    target_base: pathlib.Path,
    media: str,
) -> tuple[pathlib.Path, str]:
    kind = media_kind(media, source)
    direct = {"pdf": ".pdf", "png": ".png", "jpg": ".jpg"}
    if kind in direct:
        target = target_base.with_suffix(direct[kind])
        target.parent.mkdir(parents=True, exist_ok=True)
        descriptor, name = tempfile.mkstemp(dir=target.parent, suffix=target.suffix)
        os.close(descriptor)
        temporary = pathlib.Path(name)
        try:
            shutil.copyfile(source, temporary)
            os.chmod(temporary, 0o644)
            os.replace(temporary, target)
        finally:
            temporary.unlink(missing_ok=True)
        return target, "source artwork copied without content conversion"
    target_suffix = ".pdf" if kind in {"svg", "eps"} else ".png"
    target = target_base.with_suffix(target_suffix)
    target.parent.mkdir(parents=True, exist_ok=True)
    descriptor, name = tempfile.mkstemp(dir=target.parent, suffix=target_suffix)
    os.close(descriptor)
    temporary = pathlib.Path(name)
    temporary.unlink()
    try:
        arguments = convert_command(kind, source, temporary)
        completed = subprocess.run(
            arguments,
            cwd=REPOSITORY,
            env=environment(),
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        if completed.returncode != 0 or not temporary.is_file():
            detail = normalise(completed.stderr.decode("utf-8", errors="replace"))
            raise RuntimeError(f"{command_text(arguments)} failed: {detail}")
        os.chmod(temporary, 0o644)
        os.replace(temporary, target)
    finally:
        temporary.unlink(missing_ok=True)
    return target, f"source {kind.upper()} converted to {target_suffix[1:].upper()}"


def reference_artwork(
    record: BankRecord,
    reference: ReferenceRecord,
    role: str,
    manifest_path: pathlib.Path,
    artwork_directory: pathlib.Path,
) -> Artwork:
    path_text = getattr(reference, f"{role}_path")
    if path_text == "-":
        unavailable = [
            getattr(reference, f"{role}_{field}")
            for field in ("url", "sha256", "media")
        ]
        if unavailable != ["-", "-", "-"]:
            raise ValueError(f"inconsistent missing {role} fields for {record.slug}")
        return Artwork(
            None,
            "missing",
            "source manifest records no artwork",
            f"No {role} artwork is supplied by the reference manifest. This does "
            "not assert that no mathematical artwork exists.",
        )
    source = resolve_manifest_path(path_text, manifest_path)
    if not source.is_file():
        raise FileNotFoundError(f"reference artwork does not exist: {source}")
    expected_hash = getattr(reference, f"{role}_sha256")
    source_url = getattr(reference, f"{role}_url")
    media = getattr(reference, f"{role}_media")
    if source_url == "-" or media == "-":
        raise ValueError(f"incomplete {role} provenance for {record.slug}")
    if not re.fullmatch(r"[0-9a-fA-F]{64}", expected_hash):
        raise ValueError(f"invalid {role} SHA-256 for {record.slug}")
    actual_hash = sha256(source)
    if actual_hash.lower() != expected_hash.lower():
        raise ValueError(f"{role} SHA-256 mismatch for {record.slug}")
    target, conversion = copy_or_convert_reference(
        source, artwork_directory / f"reference-{record.slug}-{role}", media
    )
    caption = (
        f"reference artwork; {normalise(media)}; SHA-256 {actual_hash[:16]}…; "
        f"{conversion}"
    )
    return Artwork(
        target,
        caption,
        conversion,
        source_url=source_url,
    )


def native_artwork(
    presentation: Presentation,
    aper: pathlib.Path,
    artwork_directory: pathlib.Path,
) -> tuple[Artwork, Artwork]:
    patch_arguments = [
        str(aper),
        "-t",
        presentation.aper_system,
        "-s",
        presentation.seed,
        "-c",
        presentation.colour,
        "-n",
        str(presentation.depth),
    ]
    rule_arguments = [
        str(aper),
        "-t",
        presentation.aper_system,
        "--rule",
        "-c",
        presentation.colour,
    ]
    patch = artwork_directory / f"native-{presentation.aper_system}-patch.pdf"
    rule = artwork_directory / f"native-{presentation.aper_system}-rule.pdf"
    render_pdf(patch_arguments, patch, REPOSITORY)
    render_pdf(rule_arguments, rule, REPOSITORY)
    patch_display = ["./aper", *patch_arguments[1:]]
    rule_display = ["./aper", *rule_arguments[1:]]
    return (
        Artwork(patch, f"native vector PDF; command: {command_text(patch_display)}", ""),
        Artwork(rule, f"native vector PDF; command: {command_text(rule_display)}", ""),
    )


def candidate_artwork(
    candidate: Candidate,
    aper_search: pathlib.Path,
    artwork_directory: pathlib.Path,
) -> tuple[Artwork, Artwork]:
    patch_arguments = [
        str(aper_search),
        "--space",
        "binary-square",
        "--candidate",
        str(candidate.index),
        "-n",
        "4",
    ]
    rule_arguments = [
        str(aper_search),
        "--space",
        "binary-square",
        "--candidate",
        str(candidate.index),
        "--rule",
    ]
    patch = artwork_directory / f"candidate-{candidate.index:02d}-patch.pdf"
    rule = artwork_directory / f"candidate-{candidate.index:02d}-rule.pdf"
    render_pdf(patch_arguments, patch, REPOSITORY)
    render_pdf(rule_arguments, rule, REPOSITORY)
    patch_display = ["./aper-search", *patch_arguments[1:]]
    rule_display = ["./aper-search", *rule_arguments[1:]]
    return (
        Artwork(patch, f"native search PDF; command: {command_text(patch_display)}", ""),
        Artwork(rule, f"native search PDF; command: {command_text(rule_display)}", ""),
    )


def relative_artwork_path(path: pathlib.Path, output: pathlib.Path) -> str:
    try:
        return path.relative_to(output).as_posix()
    except ValueError as error:
        raise ValueError(f"generated artwork escaped output directory: {path}") from error


def artwork_tex(role: str, artwork: Artwork, output: pathlib.Path) -> str:
    if artwork.path is None:
        return rf"\CataloguePlaceholder{{{tex(role)}}}{{{tex(artwork.missing)}}}"
    path = relative_artwork_path(artwork.path, output)
    caption = tex(artwork.caption)
    if artwork.source_url:
        caption += rf"; source: \url{{{artwork.source_url}}}"
    return (
        rf"\CatalogueArtwork{{{tex(role)}}}{{{path}}}"
        rf"{{{caption}}}"
    )


def plate_tex(
    anchor: str,
    title: str,
    status: str,
    colour: str,
    source: str,
    tags: str,
    changes: str,
    patch: Artwork,
    rule: Artwork,
    output: pathlib.Path,
) -> str:
    return "\n".join(
        [
            rf"\CataloguePlate{{{anchor}}}{{{tex(title)}}}",
            rf"{{\CatalogueStatus{{{colour}}}{{{tex(status)}}}}}",
            rf"{{{source}}}",
            rf"{{{tags}}}",
            rf"{{{tex(changes)}}}",
            "{" + artwork_tex("Patch", patch, output) + "}",
            "{" + artwork_tex("Substitution rule", rule, output) + "}",
            "",
        ]
    )


def make_build_info(
    metadata: dict[str, str],
    bank_count: int,
    native_count: int,
    candidates: int,
    reference_patch_count: int,
    reference_rule_count: int,
    aper_version: str,
) -> str:
    snapshot = metadata.get("source-last-modified", "not recorded")
    etag = metadata.get("source-etag", "not recorded")
    values = {
        "CatalogueBankCount": str(bank_count),
        "CatalogueNativeCount": str(native_count),
        "CatalogueCandidateCount": str(candidates),
        "CatalogueReferencePatchCount": str(reference_patch_count),
        "CatalogueReferenceRuleCount": str(reference_rule_count),
        "CatalogueAperVersion": aper_version,
        "CatalogueSnapshotDate": snapshot,
        "CatalogueSnapshotEtag": etag,
    }
    return "".join(
        rf"\newcommand{{\{name}}}{{{tex(value)}}}" + "\n"
        for name, value in values.items()
    )


def make_search_comparison(listing: Optional[SearchListing], smoke: bool) -> str:
    if listing is None:
        note = "Search candidates were omitted by the explicitly incomplete smoke build."
        return "\n".join(
            [
                r"\section*{Search comparison}",
                r"\markboth{Search comparison}{Search comparison}",
                tex(note),
                "",
            ]
        )
    stats = listing.statistics
    lines = [
        r"\section*{Search comparison}",
        r"\markboth{Search comparison}{Search comparison}",
        (
            f"The binary-square run generated {tex(stats['generated'])} labelled rules; "
            f"{tex(stats['structurally-valid'])} were structurally valid, "
            f"{tex(stats['algebraically-valid'])} algebraically valid, and "
            f"{tex(stats['geometrically-valid'])} geometrically valid. "
            f"Canonicalisation retained {tex(stats['unique'])} unique candidates. "
            "The final column reports exact canonical equality only against the "
            f"{tex(stats['encoded-bank'])} encoded bank systems."
        ),
        "",
        r"\begin{longtable}{@{}r>{\raggedright\arraybackslash}p{0.48\textwidth}>{\raggedright\arraybackslash}p{0.35\textwidth}@{}}",
        r"\toprule",
        r"Index & Generated system & Exact encoded-bank match \\",
        r"\midrule",
        r"\endhead",
    ]
    for candidate in listing.candidates:
        matches = (
            ", ".join(candidate.exact_bank_match)
            if candidate.exact_bank_match
            else f"none among the {stats['encoded-bank']} exact encodings"
        )
        lines.append(
            f"{candidate.index} & {tex(candidate.system)} & {tex(matches)} \\\\"
        )
    lines.extend([r"\bottomrule", r"\end{longtable}", ""])
    if smoke:
        lines.append(r"\emph{This table was produced during a smoke build.}")
    return "\n".join(lines) + "\n"


def make_plates(
    records: tuple[BankRecord, ...],
    systems: tuple[Presentation, ...],
    references: dict[str, ReferenceRecord],
    reference_manifest: pathlib.Path,
    listing: Optional[SearchListing],
    aper: pathlib.Path,
    aper_search: pathlib.Path,
    output: pathlib.Path,
    smoke: bool,
) -> tuple[str, list[pathlib.Path], int, int]:
    artwork_directory = output / "artwork"
    artwork_directory.mkdir(parents=True, exist_ok=True)
    by_record = {system.record: system for system in systems}
    lines = [r"\clearpage", r"\pdfbookmark[0]{Bank records}{bank-records}", ""]
    generated_artwork: list[pathlib.Path] = []
    reference_patch_count = 0
    reference_rule_count = 0
    for number, record in enumerate(records, start=1):
        presentation = by_record.get(record.slug)
        if presentation is not None:
            patch, rule = native_artwork(presentation, aper, artwork_directory)
            status = f"native aper encoding · bank record {number} of {len(records)}"
            status_colour = "apernative"
            changes = (
                "Local vector rendering; no Encyclopedia artwork reproduced. "
                "Metadata whitespace normalised and composed for this page."
            )
        else:
            reference = references.get(record.slug)
            if reference is None:
                if not smoke:
                    raise ValueError(f"reference manifest has no row for {record.slug}")
                patch = Artwork(None, "missing", "smoke placeholder", "Reference patch not cached in smoke build.")
                rule = Artwork(None, "missing", "smoke placeholder", "Reference rule not cached in smoke build.")
                changes = "Explicitly incomplete smoke build; no reference manifest row used."
            else:
                if reference.page_url != record.url:
                    raise ValueError(f"reference page URL mismatch for {record.slug}")
                patch = reference_artwork(
                    record, reference, "patch", reference_manifest, artwork_directory
                )
                rule = reference_artwork(
                    record, reference, "rule", reference_manifest, artwork_directory
                )
                source_change = (
                    "no source change stated" if reference.change == "-" else normalise(reference.change)
                )
                conversions = "; ".join(
                    dict.fromkeys([patch.change, rule.change])
                )
                changes = (
                    f"Source manifest: {source_change}; {conversions}; scaled and "
                    "composed for this page. CC BY-NC-SA 2.0."
                )
            reference_patch_count += int(patch.path is not None)
            reference_rule_count += int(rule.path is not None)
            status = f"reference only · bank record {number} of {len(records)}"
            status_colour = "aperreference" if patch.path or rule.path else "apermissing"
        generated_artwork.extend(
            artwork.path for artwork in (patch, rule) if artwork.path is not None
        )
        tags = ", ".join(record.tags) if record.tags else r"\emph{none recorded}"
        source = rf"\url{{{record.url}}}"
        lines.append(
            plate_tex(
                f"bank-{record.slug}",
                record.title,
                status,
                status_colour,
                source,
                tags if tags.startswith("\\") else tex(tags),
                changes,
                patch,
                rule,
                output,
            )
        )
    if listing is not None:
        lines.extend(
            [r"\clearpage", r"\pdfbookmark[0]{Search candidates}{search-candidates}", ""]
        )
        for candidate in listing.candidates:
            patch, rule = candidate_artwork(candidate, aper_search, artwork_directory)
            generated_artwork.extend([patch.path, rule.path])
            exact = (
                "exact encoded-bank match: " + ", ".join(candidate.exact_bank_match)
                if candidate.exact_bank_match
                else (
                    "no exact match among the "
                    f"{listing.statistics['encoded-bank']} encoded rules"
                )
            )
            lines.append(
                plate_tex(
                    f"candidate-{candidate.index}",
                    f"Search candidate {candidate.index}: {candidate.system}",
                    f"bounded-search candidate · {exact}",
                    "apernative",
                    r"local \texttt{aper-search}; space \texttt{binary-square}",
                    r"binary-square, canonical candidate",
                    (
                        "Locally generated after bounded validation and canonicalisation. "
                        "Candidate status is not a novelty, nonperiodicity, or aperiodicity claim."
                    ),
                    patch,
                    rule,
                    output,
                )
            )
    return (
        "\n".join(lines) + "\n",
        generated_artwork,
        reference_patch_count,
        reference_rule_count,
    )


def write_hash_manifest(paths: list[pathlib.Path], output: pathlib.Path) -> None:
    unique = sorted(set(paths), key=lambda path: path.as_posix())
    lines = [
        f"{sha256(path)}  {relative_artwork_path(path, output)}" for path in unique
    ]
    atomic_write(output / "plate-assets.sha256", "\n".join(lines) + "\n")


def copy_template(template: pathlib.Path, output: pathlib.Path) -> None:
    atomic_write(output / "aper-catalogue.tex", template.read_text(encoding="utf-8"))


def run_latex(output: pathlib.Path) -> pathlib.Path:
    latexmk = shutil.which("latexmk")
    pdflatex = shutil.which("pdflatex")
    if not latexmk or not pdflatex:
        raise RuntimeError("catalogue PDF requires latexmk and pdflatex")
    for suffix in ("aux", "fdb_latexmk", "fls", "log", "out", "pdf", "toc"):
        (output / f"aper-catalogue.{suffix}").unlink(missing_ok=True)
    arguments = [
        latexmk,
        "-pdf",
        f"-pdflatex={pdflatex} %O %S",
        "-interaction=nonstopmode",
        "-halt-on-error",
        "-file-line-error",
        "aper-catalogue.tex",
    ]
    run_text(arguments, output)
    document = output / "aper-catalogue.pdf"
    if not document.is_file() or not document.read_bytes().startswith(b"%PDF-"):
        raise RuntimeError("latexmk did not produce aper-catalogue.pdf")
    log = (output / "aper-catalogue.log").read_text(encoding="utf-8", errors="replace")
    forbidden = (
        "Undefined control sequence",
        "There were undefined references",
        "Overfull \\hbox",
        "Overfull \\vbox",
        "PDF inclusion: found PDF version",
    )
    found = [message for message in forbidden if message in log]
    if found:
        raise RuntimeError("catalogue LaTeX log contains: " + ", ".join(found))
    return document


def build(arguments: argparse.Namespace) -> pathlib.Path:
    bank_path = arguments.bank.resolve()
    systems_path = arguments.systems.resolve()
    template_path = arguments.template.resolve()
    output = arguments.output_dir.resolve()
    reference_manifest = arguments.reference_manifest.resolve()
    aper = arguments.aper.resolve()
    aper_search = arguments.aper_search.resolve()
    for path in (bank_path, systems_path, template_path, aper, aper_search):
        if not path.exists():
            raise FileNotFoundError(path)
    output.mkdir(parents=True, exist_ok=True)

    metadata, records = read_bank(bank_path)
    systems = read_systems(systems_path)
    known = read_known_listing(aper_search)
    validate_system_mappings(records, systems, known)

    if reference_manifest.is_file():
        references = read_reference_manifest(reference_manifest)
    elif arguments.smoke:
        references = {}
    else:
        raise FileNotFoundError(
            f"reference-art manifest is required for a complete build: {reference_manifest}"
        )
    reference_only = {record.slug for record in records if not record.aper_system}
    unknown_references = set(references) - {record.slug for record in records}
    if unknown_references:
        raise ValueError(
            "reference manifest contains unknown slugs: "
            + ", ".join(sorted(unknown_references))
        )
    missing_reference_rows = reference_only - set(references)
    if missing_reference_rows and not arguments.smoke:
        raise ValueError(
            "reference manifest omits reference-only rows: "
            + ", ".join(sorted(missing_reference_rows))
        )

    try:
        listing: Optional[SearchListing] = read_candidates(aper_search)
    except (RuntimeError, ValueError):
        if not arguments.smoke:
            raise
        listing = None

    plates, artwork, patch_count, rule_count = make_plates(
        records,
        systems,
        references,
        reference_manifest,
        listing,
        aper,
        aper_search,
        output,
        arguments.smoke,
    )
    aper_version = normalise(run_text([str(aper), "--version"], REPOSITORY))
    candidate_count = 0 if listing is None else len(listing.candidates)
    atomic_write(
        output / "build-info.tex",
        make_build_info(
            metadata,
            len(records),
            len(systems),
            candidate_count,
            patch_count,
            rule_count,
            aper_version,
        ),
    )
    atomic_write(
        output / "search-comparison.tex",
        make_search_comparison(listing, arguments.smoke),
    )
    atomic_write(output / "plates.tex", plates)
    write_hash_manifest(artwork, output)
    copy_template(template_path, output)
    if arguments.no_latex:
        return output / "aper-catalogue.pdf"
    return run_latex(output)


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(description=__doc__)
    result.add_argument("--bank", type=pathlib.Path, default=DEFAULT_BANK)
    result.add_argument("--systems", type=pathlib.Path, default=DEFAULT_SYSTEMS)
    result.add_argument("--template", type=pathlib.Path, default=DEFAULT_TEMPLATE)
    result.add_argument(
        "--reference-manifest",
        type=pathlib.Path,
        default=DEFAULT_REFERENCE_MANIFEST,
    )
    result.add_argument("--output-dir", type=pathlib.Path, default=DEFAULT_OUTPUT)
    result.add_argument("--aper", type=pathlib.Path, default=REPOSITORY / "aper")
    result.add_argument(
        "--aper-search", type=pathlib.Path, default=REPOSITORY / "aper-search"
    )
    result.add_argument(
        "--smoke",
        action="store_true",
        help="allow an incomplete reference manifest or unavailable candidate CLI",
    )
    result.add_argument(
        "--no-latex", action="store_true", help="generate assets and TeX without PDF"
    )
    return result


def main() -> int:
    arguments = parser().parse_args()
    try:
        document = build(arguments)
    except (OSError, RuntimeError, ValueError) as error:
        print(f"build-catalogue: {error}", file=sys.stderr)
        return 1
    if arguments.no_latex:
        print(f"generated catalogue inputs in {arguments.output_dir}")
    else:
        print(document)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
